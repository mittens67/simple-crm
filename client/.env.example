# Backend API URL
# In development: uses Vite proxy to http://localhost:4000
# In production: set to actual backend url 
VITE_API_URL=http://localhost:4000

# Demo accounts card on the login page.
# In development it shows the seed's default password automatically.
# A production build hides the card unless this is set, so a public login page
# never advertises a password nobody chose to publish. Set it to the same value
# as the server's DEMO_PASSWORD if you want the card visible on a deployed demo.
# VITE_DEMO_PASSWORD=
