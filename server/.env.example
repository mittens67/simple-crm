# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=

# JWT secrets (generate random strings for production)
# Use: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Server port (default: 4000)
PORT=4000

# Admin account credentials (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# CORS allowed origins (comma-separated)
# Default: http://localhost:5173,http://localhost:3000
# For production, set to your actual frontend URL(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
NODE_ENV=development

# --- AI ---------------------------------------------------------------------
# Leave AI_PROVIDER unset (or "mock") to use the built-in deterministic model.
# Every AI feature works with no key and no network — that is the default so a
# fresh clone and CI both run.
#
# Set to "gemini" or "mistral" plus the matching key to use a real model.
# Both have free tiers; Gemini's is region-restricted and Mistral's requires
# phone verification.
AI_PROVIDER=mock

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Hard ceiling on a single model call, enforced with AbortController.
AI_TIMEOUT_MS=15000
# Per-user calls per minute; free tiers have low RPM ceilings.
AI_RATE_LIMIT_PER_MINUTE=10
# How long an identical prompt's answer is reused.
AI_CACHE_TTL_MS=900000
# Lead scores older than this are re-scored on demand.
AI_SCORE_TTL_MS=86400000

# Password for the seeded demo accounts (required when NODE_ENV=production).
DEMO_PASSWORD=
